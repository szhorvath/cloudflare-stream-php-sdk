{
    "name": "szhorvath/cloudflare-stream-php-sdk",
    "description": "A PHP SDK for integrating Cloudflare Streaming services.",
    "keywords": [
        "szhorvath",
        "cloudflare-stream-php-sdk"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Szhorvath\\CloudflareStream\\": "src/",
            "Szhorvath\\CloudflareStream\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sandor Horvath",
            "email": "z.sandor.horvath@gmail.com",
            "role": "Developer"
        }
    ],
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "test-parallel": "vendor/bin/pest --parallel",
        "test-coverage": "vendor/bin/pest --coverage",
        "test-type": "vendor/bin/pest --type-coverage",
        "format": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse src"
    },
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "psr/http-message": "^2.0",
        "psr/http-client-implementation": "^1.0",
        "php-http/httplug": "^2.4",
        "psr/http-factory": "^1.1",
        "php-http/discovery": "^1.20",
        "psr/http-factory-implementation": "^1.0",
        "php-http/client-common": "^2.7",
        "php-http/cache-plugin": "^2.0",
        "illuminate/collections": "^13.16.1",
        "league/object-mapper": "dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.20.0",
        "nyholm/psr7": "^1.8.2",
        "pestphp/pest": "^2.0 || ^3.7",
        "pestphp/pest-plugin-type-coverage": "^2.0 || ^3.2",
        "php-http/message": "^1.16",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^1.12.16 || ^2.1.2",
        "spatie/ray": "1.48.0",
        "symfony/http-client": "^6.4 || ^7.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        },
        "minimum-stability": "dev",
        "prefer-stable": true
    }
}
